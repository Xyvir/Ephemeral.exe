<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX authoring for the Ephemeral Distributed (Instructor) MSI.

  The design rules below are deliberate, and test_ui.py guards them:

  * Per-machine, installed for every user. The point of this installer is a
    machine that serves the cluster, so the app goes in %ProgramFiles% with one
    Common Start Menu shortcut, and the node it starts is registered under the
    machine-wide Run key (HKLM) rather than one user's (HKCU). That is why the
    install raises a UAC prompt: writing %ProgramFiles% and HKLM is exactly what
    administrator rights are for. It happens once, visibly, with the user's
    consent — the app itself still never self-elevates and ships no service,
    scheduled task or SYSTEM component (see the tests that keep it that way).
  * Exactly one custom action, and it does one thing: start the app that was
    just installed, once. An MSI cannot launch a program declaratively, and the
    classroom link a teacher actually needs only exists once the app runs (it
    creates this machine's private swarm and prints the student URL, see
    InstructorBackend), so the installer does it in the least
    interesting shape available: the installed exe and nothing else, no script
    and no shell, no elevation, in the user's own context, fire-and-forget,
    after InstallFinalize, on a fresh install, and never for a silent
    `msiexec /qn` deployment. It writes no registry value, needs no cleanup,
    and uninstall does not depend on it. Everything else stays declarative:
    custom actions that write the registry or elevate are what installer
    malware detection hunts for, and there are none of those here. (An opt-in
    "launch when setup finishes" checkbox on the Finish dialog is the other
    standard pattern; it needs the WixUtilExtension and a custom dialog, and it
    would leave a teacher without the link unless they ticked it.)
  * The default-on "start at login" feature writes an HKLM Run value that
    starts the normal tray app when *any* user logs in, including a professor
    who is not the account that installed it. It is the same thing as the tray's
    "Install & Run on Boot" item, just set for every user at install time, and
    it is visible to the user: no background node, no headless mode. Its
    component keypath is a separate marker value, so a user who turns start-on-
    boot off in the tray does not have Windows Installer repair silently switch
    it back on.
  * Staying per-machine also keeps MSI honest: file-keyed components are the
    supported model, and ICE38/ICE91 (which only apply to user-profile
    directories) simply do not arise, so validation needs no suppressions.
  * Application files arrive as one harvested ComponentGroup (see
    build_msi.sh for the heat invocation), so the payload is a plain file
    install rather than an archive unpacked by code at install time.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Ephemeral Distributed (Instructor)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Ephemeral"
           UpgradeCode="00B73DB1-B66B-4A71-9AE7-3C3E9E1C6971">

    <!-- Per-machine is the default scope; stating it keeps the intent explicit
         and testable. InstallPrivileges="elevated" is the matching half: the
         installer asks for the rights it needs up front instead of failing
         halfway through a write to %ProgramFiles%.

         Do not "simplify" this to perUser + ALLUSERS/MSIINSTALLPERUSER: that
         combination only supports one user's copy under %LOCALAPPDATA% and
         Windows Installer ignores the property on a no-elevation package. -->
    <Package Id="*"
             InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"
             Platform="x64"
             Description="Ephemeral distributed instructor client"
             Comments="Sandboxed code execution: one-shot containers, no daemon." />

    <!-- ProductCode is new per build (Id="*"); the stable UpgradeCode plus
         AllowSameVersionUpgrades lets a professor re-run the installer over an
         older build without an "already installed" error. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Ephemeral Distributed (Instructor) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <UIRef Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- %ProgramFiles%: one copy for the whole machine, readable by every
           user, writable only by an administrator. The app keeps per-user
           state in %LOCALAPPDATA% at runtime, so nothing needs write access
           here. -->
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Ephemeral-Distributed-Instructor">
          <Component Id="NodeAtLogin" Guid="D891E1CD-BA75-4995-AB2C-9C7262BC3EC2">
            <!-- Keypath is a marker value nobody toggles, not the Run value. -->
            <RegistryValue Root="HKLM"
                           Key="Software\Ephemeral\Ephemeral-Distributed-Instructor"
                           Name="NodeAtLogin" Type="integer" Value="1"
                           KeyPath="yes" />
            <!-- Machine-wide login entry: every user login on this PC starts the
                 tray app. The value name is the instructor app_key, so the
                 tray's "Install & Run on Boot" check and toggle see it. -->
            <RegistryValue Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="Ephemeral-Distributed-Instructor" Type="string"
                           Value="&quot;[INSTALLDIR]Ephemeral-Distributed-Instructor.exe&quot;"
                           KeyPath="no" />
          </Component>

          <!-- Shortcut component lives in %ProgramFiles% and keys on HKLM;
               only the .lnk itself points into the Start Menu, which for this
               ALLUSERS=1 package is the all-users menu. See build_msi.sh for
               the two ICE checks this deliberately overrides. -->
          <Component Id="StartMenuShortcut" Guid="68B8D107-4566-4643-8413-292D96A175E8">
            <Shortcut Id="AppShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Ephemeral Distributed (Instructor)"
                      Description="Run clipboard codeblocks in sandboxed containers"
                      Target="[INSTALLDIR]Ephemeral-Distributed-Instructor.exe"
                      WorkingDirectory="INSTALLDIR" />
            <RegistryValue Root="HKLM"
                           Key="Software\Ephemeral\Ephemeral-Distributed-Instructor"
                           Name="StartMenuShortcut" Type="integer" Value="1"
                           KeyPath="yes" />
          </Component>

        </Directory>
      </Directory>
      <!-- ProgramMenuFolder, not CommonProgramsFolder: on an ALLUSERS=1
           package Windows Installer resolves ProgramMenuFolder to the common
           (all users) Start Menu, while CommonProgramsFolder resolved to C:\
           in the install log and dropped the shortcut at the drive root.

           The shortcut points here and MSI writes it into the all-users
           menu, but no component is located here: a component inside a Start
           Menu folder would have to key on HKCU, which a machine-wide package
           must not do. -->
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <Feature Id="ApplicationFiles" Title="Ephemeral Distributed (Instructor)"
             Level="1" Display="1"
             Description="The tray client: clipboard runs, the Distributed menu, and the pre-hydration console.">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Default-on: the installer exists so this machine serves the cluster,
         but Absent="allow" makes it a real checkbox in the feature tree, and
         `msiexec ADDLOCAL=ApplicationFiles` skips it for a silent install that
         should not serve. -->
    <Feature Id="NodeAtLogin" Title="Install &amp; Run on Boot"
             Level="1" Display="2"
             Absent="allow"
             Description="Start Ephemeral's tray app whenever anyone logs in to this PC, so its classroom link and Distributed menu are ready. Machine-wide, with no Windows service and no SYSTEM task. Remove it later with REMOVE=NodeAtLogin.">
      <ComponentRef Id="NodeAtLogin" />
    </Feature>

    <!-- Launch the installed app once, as the user who installed it.

         Type 34 needs the full path in ExeCommand (Directory is only the
         working directory), and the exe name is quoted for the same reason:
         Windows Installer resolves it at run time. Only the app is launched:
         no cmd.exe, no PowerShell, no script host. asyncNoWait means a
         tray that fails to start cannot wedge the installer. -->
    <CustomAction Id="LaunchInstructorFirstRun"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]Ephemeral-Distributed-Instructor.exe&quot; --first-run"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- The setup bundle installs this package quietly (that is how Burn runs
         an MSI), so UILevel is 2 there and the silent guard would suppress the
         launch precisely when a teacher is watching setup finish. The bundle
         therefore passes LAUNCHFIRSTRUN=1 to opt in explicitly, while a plain
         `msiexec /qn` from a deployment tool stays silent.

         The rest is unchanged: after InstallFinalize so the files exist,
         `NOT Installed` keeps it off repair and maintenance, and `NOT REMOVE`
         keeps it off uninstall. -->
    <Property Id="LAUNCHFIRSTRUN" Value="0" />
    <InstallExecuteSequence>
      <Custom Action="LaunchInstructorFirstRun" After="InstallFinalize">
        <![CDATA[NOT Installed AND NOT REMOVE AND (UILevel <> 2 OR LAUNCHFIRSTRUN = 1)]]>
      </Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
